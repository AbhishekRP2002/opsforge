      "name": "apply_leave",
      "description": "Apply for a new leave.",
      "raw_input_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "employee_no": {
                  "type": "string",
